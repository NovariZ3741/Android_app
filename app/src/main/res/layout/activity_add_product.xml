<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <EditText android:id="@+id/etSku" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="SKU" />

    <EditText android:id="@+id/etName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Nama produk" />

    <EditText android:id="@+id/etCategory" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Kategori" />

    <EditText android:id="@+id/etPrice" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Harga (Rp)"
        android:inputType="numberDecimal" />

    <EditText android:id="@+id/etMinStock" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Stok minimum"
        android:inputType="number" />

    <Button android:id="@+id/btnSave" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:text="Simpan" />

    <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
        android:visibility="gone" />
</LinearLayout>